# ==============================================================================
# RAILBLOCK Frontend Environment Configuration (Vercel / Local)
# ==============================================================================

# Centralized Backend API Base URL (Render HTTPS URL in production)
# Example Production: https://railblock-api.onrender.com/api
# Example Local Dev: http://localhost:8080/api
VITE_API_BASE_URL=https://railblock-api.onrender.com/api

# Optional explicit WebSocket URL override (If omitted, automatically derived from VITE_API_BASE_URL)
# Example Production: wss://railblock-api.onrender.com/ws/events
# Example Local Dev: ws://localhost:8080/ws/events
# VITE_WS_URL=wss://railblock-api.onrender.com/ws/events

# Live backend mode (Set to false so all requests go to central PostgreSQL backend)
VITE_USE_MOCK=false
VITE_APP_TITLE=RAILBLOCK
VITE_SIH_PS=26027
