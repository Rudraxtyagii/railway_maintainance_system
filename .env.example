# ==============================================================================
# RAILBLOCK Multi-Tier Production Environment Configuration
# ==============================================================================

# Central PostgreSQL Database (Render Managed PostgreSQL or Docker)
DATABASE_URL=postgresql://railblock_user:railblock_password_here@dpg-xxxxxx.oregon-postgres.render.com/railblock_db
POSTGRES_USER=railblock_user
POSTGRES_PASSWORD=railblock_password_here
POSTGRES_DB=railblock_db

# Security & JWT Tokens (Render Environment Variable)
JWT_SECRET=generate_or_set_a_secure_random_jwt_secret_key_here

# Backend CORS Whitelist (Include deployed Vercel frontend URL)
CORS_ORIGINS=https://railblock.vercel.app,http://localhost:5173

# Frontend Connection to Backend (Vercel Environment Variable)
VITE_API_BASE_URL=https://railblock-api.onrender.com/api
VITE_USE_MOCK=false
