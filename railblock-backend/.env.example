# ==============================================================================
# RAILBLOCK FastAPI Backend Environment Configuration
# ==============================================================================

# Database Connection (Render Managed PostgreSQL or Local PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://railblock_user:railblock_password_here@dpg-xxxxxx.oregon-postgres.render.com/railblock_db

# Security & JWT Tokens (Must be a cryptographically secure string in production)
JWT_SECRET=generate_or_set_a_secure_random_jwt_secret_key_here
RAILBLOCK_JWT_SECRET=generate_or_set_a_secure_random_jwt_secret_key_here

# Allowed CORS Origins (Comma-separated list of origins)
# In production, set to your deployed Vercel domain(s)
CORS_ORIGINS=https://railblock.vercel.app,https://your-custom-domain.com,http://localhost:5173

# Application Environment
ENVIRONMENT=production
PORT=8080
